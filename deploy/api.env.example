# /opt/fromzero/api.env  (chmod 600, owner fromzero)
PORT=3001
HOST=127.0.0.1
DATA_DIR=/opt/fromzero/data

# Where booking notifications go
NOTIFY_TO=mihai@fromzero.ro
MAIL_FROM=fromzero.ro <noreply@fromzero.ro>

# SMTP of the mail server running on the same VPS (Stalwart / Mailcow).
# Leave SMTP_HOST empty until the mail server is up - bookings are still saved to disk.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@fromzero.ro
SMTP_PASS=
